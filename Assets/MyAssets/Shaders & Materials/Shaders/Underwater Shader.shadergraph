    "m_ObjectId": "8fc373b59fff4f2abb4292946318ef54",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetCameraRayPlaneIntersection (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 3757.333984375,
            "y": 1138.666748046875,
            "width": 339.33349609375,
            "height": 168.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "4c2d5b045ac34d459578d6d7f377e3cd"
        },
        {
            "m_Id": "635fbc5de3c14c7d8f6625e8835a305d"
        },
        {
            "m_Id": "41cdb23fda8b44e784fd400b971f6c00"
        },
        {
            "m_Id": "bc54f9daec8740119dc9eb86aa00fa81"
        },
        {
            "m_Id": "faea86821959467ea2a126cb727e94bb"
        },
        {
            "m_Id": "e673231ae7f6483fa65c1ad0b07cb6f6"
        },
        {
            "m_Id": "c8b932c455434e8fab1522b83d86f507"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetCameraRayPlaneIntersection",
    "m_FunctionSource": "e07296e56c5201c468320b341ed8a7b4",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void GetScreenPixelWorldPos_float(float LensScale, float AspectRatio, out float3 WorldPos)\r\n{\r\n    float2 uv = _ScreenPosition.xy / max(_ScreenPosition.w, 0.00001);\r\n    \r\n    #if defined(UNITY_UV_STARTS_AT_TOP)\r\n    if (_ProjectionParams.x < 0.0)\r\n        uv.y = 1.0 - uv.y;\r\n    #endif\r\n\r\n    float2 centeredUV = uv - 0.5;\r\n    centeredUV.x *= AspectRatio;\r\n    centeredUV.y *= -1.0;\r\n    centeredUV *= LensScale;\r\n\r\n    float3 camPos = _WorldSpaceCameraPos;\r\n    float3 camRight = UNITY_MATRIX_V[0].xyz;\r\n    float3 camUp    = UNITY_MATRIX_V[1].xyz;\r\n\r\n    WorldPos = camPos + (camRight * centeredUV.x) + (camUp * centeredUV.y);\r\n}"
}

