    "m_Name": "SmoothWaterMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 5839.33349609375,
            "y": 1067.3333740234375,
            "width": 262.6669921875,
            "height": 120.0
        }
