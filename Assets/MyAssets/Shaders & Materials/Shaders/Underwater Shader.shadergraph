    "m_SourceType": 0,
    "m_FunctionName": "SmoothWaterMask",
    "m_FunctionSource": "e07296e56c5201c468320b341ed8a7b4",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void SmoothWaterMask_float(float SurfaceY, float PointY, out float Mask)\r\n{\r\n    float diff = PointY - SurfaceY;\r\n    float aa = max(fwidth(diff), 1e-5); // width of one pixel in \"diff\" units\r\n    Mask = 1.0 - smoothstep(-aa, aa, diff); // 1 = underwater, 0 = above, soft over ~1px\r\n}"
}

